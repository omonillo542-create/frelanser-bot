# BotFather'dan olgan tokeningiz
BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# O'zingizning Telegram ID (/@userinfobot orqali olishingiz mumkin)
ADMIN_ID=123456789

# Baza fayli yo'li (ixtiyoriy, default: loyiha papkasi/bot_data.db)
# DB_PATH=./bot_data.db

# Bot username (ixtiyoriy — bo'lmasa avtomatik aniqlanadi)
# BOT_USERNAME=my_frilans_bot

# Cheklovlar
DAILY_ORDER_LIMIT=5
MAX_ACTIVE_ORDERS=3
ORDER_TIMEOUT_MINUTES=30

# Texnik sozlamalar
PAGINATION_SIZE=8
SEND_DELAY=0.05
TZ_OFFSET_HOURS=5

# Barcha buyurtmalarni admin'ga yuborish (1/0)
ADMIN_NOTIFY_ALL=1

# ------------------- BEPUL 24/7 HOSTING (ixtiyoriy) -------------------
# Render.com worker'da diski vaqtincha — baza GitHub Gist'da saqlanadi.
# GitHub → Settings → Developer settings → Personal access tokens → "gist" scope
GIST_TOKEN=
GIST_ID=
GIST_INTERVAL_MINUTES=5

# GitHub Actions uchun: bot shu daqiqadan keyin o'z-o'zidan to'xtaydi (0 = cheksiz)
MAX_RUNTIME_MINUTES=0
